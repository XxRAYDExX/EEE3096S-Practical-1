 119:Core/Src/main.c **** void handle_buttons(void)
 120:Core/Src/main.c **** {
 121:Core/Src/main.c ****     uint32_t current_time = HAL_GetTick();
 122:Core/Src/main.c **** 
 123:Core/Src/main.c ****     /* TODO: Read the state of all four buttons (PA0 to PA3) */
 124:Core/Src/main.c ****     // Read active-low button states (1 = Pressed, 0 = Released)
 125:Core/Src/main.c ****     uint8_t button0_pressed = (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0) == GPIO_PIN_RESET);
 126:Core/Src/main.c ****     uint8_t button1_pressed = (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_1) == GPIO_PIN_RESET);
 127:Core/Src/main.c ****     uint8_t button2_pressed = (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_2) == GPIO_PIN_RESET);
 128:Core/Src/main.c ****     uint8_t button3_pressed = (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_3) == GPIO_PIN_RESET);
 129:Core/Src/main.c ****     
 130:Core/Src/main.c ****     /* TODO: Implement debounce logic for PA0. Toggle the timer speed between 500ms and 1000ms. */
 131:Core/Src/main.c ****     if (button0_pressed) {
 132:Core/Src/main.c ****         if ((current_time - last_button_time[0]) > DEBOUNCE_MS) {
 133:Core/Src/main.c ****             last_button_time[0] = current_time;
 134:Core/Src/main.c ****             speed_state = !speed_state;
 135:Core/Src/main.c ****             if(speed_state){
 136:Core/Src/main.c ****               change_timer_period(500);
 137:Core/Src/main.c ****             }
 138:Core/Src/main.c ****             else{
 139:Core/Src/main.c ****               change_timer_period(1000);
 140:Core/Src/main.c ****             }
 141:Core/Src/main.c ****         }
 142:Core/Src/main.c ****     }
 143:Core/Src/main.c ****     
 144:Core/Src/main.c ****     /* TODO: Implement debounce logic for PA1. Call set_mode(MODE_1). */
