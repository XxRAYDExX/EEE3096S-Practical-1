 190:Core/Src/main.c **** void mode1_update(void)
 191:Core/Src/main.c **** {
 192:Core/Src/main.c ****     /* TODO: Implement the standard running light sequence (Task 3 logic) */
 193:Core/Src/main.c ****     clear_all_leds();
 194:Core/Src/main.c ****     turn_on_led(current_led);
 195:Core/Src/main.c **** 
 196:Core/Src/main.c ****     current_led += direction;
 197:Core/Src/main.c ****     if (current_led == 7) {
 198:Core/Src/main.c ****         direction = -1;
 199:Core/Src/main.c ****     } else if (current_led == 0) {
 200:Core/Src/main.c ****         direction = 1;
 201:Core/Src/main.c ****     }
 202:Core/Src/main.c **** }
