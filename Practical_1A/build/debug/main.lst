 239:Core/Src/main.c ****                     sparkle_leds_on[sparkle_num_leds_on++] = i;
 240:Core/Src/main.c ****                 }
 241:Core/Src/main.c ****             }
 242:Core/Src/main.c **** 
 243:Core/Src/main.c ****             
 244:Core/Src/main.c **** 
 245:Core/Src/main.c ****             /* TODO: Generate a random display duration between 100ms and 1500ms */
 246:Core/Src/main.c ****             uint32_t display_duration = 100 + (rand() % 1401);
 247:Core/Src/main.c ****             sparkle_display_until = now + display_duration;
 248:Core/Src/main.c ****             /* TODO: Transition to SPARKLE_DISPLAY state */
