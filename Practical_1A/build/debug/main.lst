 250:Core/Src/main.c ****             break;
 251:Core/Src/main.c **** 
 252:Core/Src/main.c ****         case SPARKLE_DISPLAY:
 253:Core/Src/main.c ****             /* TODO: Wait for the random display duration to elapse using HAL_GetTick() */
